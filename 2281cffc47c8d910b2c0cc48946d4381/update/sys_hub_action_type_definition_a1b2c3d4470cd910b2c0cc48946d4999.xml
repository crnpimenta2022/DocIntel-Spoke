    <sys_variable_value action="INSERT_OR_UPDATE">
        <document>sys_hub_step_instance</document>
        <document_key>b1b2c3d4470cd910b2c0cc48946d4999</document_key>
        <order>100</order>
        <sys_class_name>sys_variable_value</sys_class_name>
        <sys_created_by>admin</sys_created_by>
        <sys_created_on>2025-11-07 06:00:00</sys_created_on>
        <sys_id>b2b2c3d4470cd910b2c0cc48946d4999</sys_id>
        <sys_mod_count>0</sys_mod_count>
        <sys_updated_by>admin</sys_updated_by>
        <sys_updated_on>2025-11-07 06:00:00</sys_updated_on>
        <value>(function execute(inputs, outputs) {
    try {
        // Get input parameters
        var assessmentId = inputs.assessment_id;
        var userId = inputs.user_id;
        var taskSysId = inputs.task_sys_id;
        var taskTableName = inputs.task_table_name;

        // Create the assessment instance using AssessmentUtils
        var result = new global.AssessmentUtils().createAssessments(assessmentId, '', userId);

        // Parse the result to get the instance ID
        // The result format is: "instanceId,groupId" or just "instanceId"
        result = result.split(',');
        var instanceId = result[0];

        // Get the assessment instance record
        var grInstance = new GlideRecord('asmt_assessment_instance');
        if (grInstance.get(instanceId)) {
            // Link the assessment instance to the task
            grInstance.setValue('task_id', taskSysId);
            grInstance.setValue('trigger_id', taskSysId);
            grInstance.setValue('trigger_table', taskTableName);
            grInstance.update();

            // Set output
            outputs.instance_id = instanceId;

            gs.info('Successfully linked assessment instance ' + instanceId + ' to task ' + taskSysId);
        } else {
            gs.error('Failed to retrieve assessment instance with ID: ' + instanceId);
            outputs.instance_id = '';
        }
    } catch (e) {
        gs.error('Error linking assessment instance to task: ' + e.message);
        outputs.instance_id = '';
    }
})(inputs, outputs);</value>
